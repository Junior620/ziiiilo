# Copier en .env.local (jamais commité) et renseigner les valeurs.

# Adresse publique du site (métadonnées, sitemap, hreflang)
NEXT_PUBLIC_SITE_URL=https://ziiiilo.tech

# Formulaire de contact — service d'e-mail transactionnel (Resend proposé)
RESEND_API_KEY=
# Adresse de réception des demandes
CONTACT_TO_EMAIL=christian.momo@ziiiilo.tech
# Expéditeur : domaine à vérifier chez Resend (enregistrements DNS dans Cloudflare)
CONTACT_FROM_EMAIL=

# Limite de débit du formulaire (facultatif, recommandé sur Vercel) — Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pages de contrôle internes (/design-tokens) en production : 1 uniquement pour les tests
ZIIIILO_DEV_PAGES=
